<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Fifth Wall — Architecture Studio · Islamabad</title>
<meta name="description" content="The Fifth Wall — Architecture and Interior Design Studio in Islamabad, Pakistan. We design from the first sketch to the last material choice. Residential, commercial, landscape and furniture design.">
<meta name="keywords" content="architecture islamabad, interior design islamabad, architect pakistan, interior designer islamabad, landscape design islamabad, the fifth wall">
<meta property="og:title" content="The Fifth Wall — Architecture Studio · Islamabad">
<meta property="og:description" content="Architecture and Interior Design Studio in Islamabad. One architect, one vision, from the first sketch to the last material choice.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://thefifthwall.pk">
<meta property="og:image" content="https://thefifthwall.pk/og-image.jpg">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="The Fifth Wall — Architecture Studio · Islamabad">
<meta name="twitter:description" content="Architecture and Interior Design Studio in Islamabad. One architect, one vision.">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Jost:wght@200;300;400;500;600&display=swap" rel="stylesheet">
<style>
/* ─── TOKENS ───────────────────────────────── */
:root {
  --ch:  #1F1F1F;
  --co:  #E5E3DE;
  --sg:  #8A8A8A;
  --br:  #8C6A3B;
  --brl: #C4976A;
  --brx: #F0E4D4;
  --wh:  #FAFAF8;
  --ease: cubic-bezier(0.25,0.46,0.45,0.94);
}

/* ─── NOISE TEXTURE ─────────────────────────── */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 9998;
  pointer-events: none;
  opacity: 0.032;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  background-size: 256px 256px;
}

/* ─── LOADING SCREEN ────────────────────────── */
#loader {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #1F1F1F;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28px;
  transition: opacity 0.8s var(--ease), visibility 0.8s;
}
#loader.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
.loader-logo {
  width: 180px;
  height: auto;
  filter: invert(1);
  animation: loaderPulse 2s ease-in-out infinite;
}
@keyframes loaderPulse {
  0%,100% { opacity:0.5; }
  50% { opacity:1; }
}
.loader-bar {
  width:120px;height:1px;
  background:rgba(229,229,229,0.07);
  position:relative;overflow:hidden;
}
.loader-bar::after {
  content:'';position:absolute;left:-100%;top:0;bottom:0;width:100%;
  background:linear-gradient(90deg,transparent,var(--br),transparent);
  animation:loaderSweep 1.4s ease-in-out infinite;
}
@keyframes loaderSweep { 0%{left:-100%} 100%{left:100%} }
.loader-coord {
  font-size:9px;letter-spacing:0.25em;
  color:rgba(140,106,59,0.4);
  font-family:'Jost',sans-serif;
}

/* ─── MANIFESTO ─────────────────────────────── */
#manifesto {
  background: var(--ch);
  padding: 140px 72px;
  position: relative;
  overflow: hidden;
  text-align: center;
}
.manifesto-bg-grid {
  position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(229,227,222,0.018) 1px,transparent 1px),
    linear-gradient(90deg,rgba(229,227,222,0.018) 1px,transparent 1px);
  background-size:72px 72px;
  pointer-events:none;
}
.manifesto-glow {
  position:absolute;top:50%;left:50%;
  transform:translate(-50%,-50%);
  width:600px;height:600px;border-radius:50%;
  background:radial-gradient(circle,rgba(140,106,59,0.05) 0%,transparent 65%);
  pointer-events:none;
}
.manifesto-eyebrow {
  font-size:9px;letter-spacing:0.42em;text-transform:uppercase;
  color:var(--br);margin-bottom:48px;position:relative;z-index:2;
}
.manifesto-statement {
  font-family:'Cormorant Garamond',serif;
  font-weight:300;
  font-size:clamp(30px,5.2vw,72px);
  line-height:1.08;color:var(--co);
  letter-spacing:-0.01em;
  max-width:880px;margin:0 auto;
  position:relative;z-index:2;
}
.manifesto-statement em { font-style:italic;color:var(--br); }
.manifesto-rule {
  width:1px;height:60px;
  background:rgba(140,106,59,0.25);
  margin:48px auto;position:relative;z-index:2;
}
.manifesto-sub {
  font-size:11px;letter-spacing:0.28em;text-transform:uppercase;
  color:rgba(229,227,222,0.18);position:relative;z-index:2;
}

/* ─── RESET ─────────────────────────────────── */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior: smooth; font-size: 16px; }

body {
  font-family: 'Jost', sans-serif;
  font-weight: 300;
  background: var(--wh);
  color: var(--ch);
  cursor: none;
  overflow-x: clip;
}

/* disable custom cursor on touch devices */
@media (hover: none), (max-width: 900px) {
  body { cursor: auto; }
  #cursor { display: none; }
  a, button { cursor: pointer; }
}

/* ─── CUSTOM CURSOR ─────────────────────────── */
#cursor {
  position: fixed;
  top: 0; left: 0;
  width: 18px; height: 18px;
  pointer-events: none;
  z-index: 9999;
  transition: transform 0.15s var(--ease);
  mix-blend-mode: difference;
}
#cursor::before,
#cursor::after {
  content: '';
  position: absolute;
  background: white;
}
#cursor::before {
  width: 1px; height: 18px;
  left: 50%; top: 0;
  transform: translateX(-50%);
}
#cursor::after {
  height: 1px; width: 18px;
  top: 50%; left: 0;
  transform: translateY(-50%);
}
body.hovering #cursor { transform: scale(2.4); }
a, button { cursor: none; }

/* ─── NAV ───────────────────────────────────── */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 48px;
  transition: background 0.4s, padding 0.4s;
  background: rgba(31,31,31,0.88);
  backdrop-filter: blur(14px);
}
nav.scrolled {
  background: rgba(31,31,31,0.97);
  padding: 16px 48px;
  backdrop-filter: blur(16px);
}
.nav-logo {
  display: flex;
  align-items: center;
  text-decoration: none;
}
.nav-logo-img {
  height: 38px;
  width: auto;
  filter: invert(1);
  opacity: 0.92;
  transition: opacity 0.25s;
}
.nav-logo-img:hover { opacity: 0.65; }
@media (max-width: 900px) {
  .nav-logo-img { height: 30px; }
}
.nav-links {
  display: flex;
  gap: 28px;
  list-style: none;
}
.nav-links a {
  font-size: 9.5px;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.45);
  text-decoration: none;
  transition: color 0.25s;
  font-weight: 400;
}
.nav-links a:hover { color: var(--brl); }
.nav-cta {
  font-size: 9.5px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--br);
  text-decoration: none;
  border: 1px solid rgba(140,106,59,0.35);
  padding: 8px 18px;
  transition: background 0.25s, color 0.25s;
  font-weight: 400;
  white-space: nowrap;
}
.nav-cta:hover { background: var(--br); color: white; }

.nav-burger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
}
.nav-burger span {
  display: block;
  width: 24px; height: 1px;
  background: white;
}

/* ─── HERO ──────────────────────────────────── */
#hero {
  min-height: 100vh;
  background: var(--ch);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0 52px 72px;
  position: relative;
  overflow: hidden;
}

/* push hero content below fixed nav on mobile */
.hero-content {
  position: relative; z-index: 2;
  max-width: 1100px;
  padding-bottom: 0;
}

/* architectural grid */
.hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(229,227,222,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(229,227,222,0.03) 1px, transparent 1px);
  background-size: 72px 72px;
}

/* animated construction lines */
.cline {
  position: absolute;
  background: rgba(140,106,59,0.18);
  transform-origin: left center;
  animation: drawLine 2.4s var(--ease) forwards;
  transform: scaleX(0);
}
.cline-h { height: 1px; }
.cline-v { width: 1px; height: 100%; transform-origin: top center; transform: scaleY(0); animation: drawVLine 2.4s var(--ease) forwards; }

@keyframes drawLine  { to { transform: scaleX(1); } }
@keyframes drawVLine { to { transform: scaleY(1); } }

.cline:nth-child(1)  { width: 45%; top: 28%; left: 0; animation-delay: 0.2s; }
.cline:nth-child(2)  { width: 30%; top: 62%; left: 20%; animation-delay: 0.5s; }
.cline:nth-child(3)  { width: 60%; top: 44%; right: 0; left: auto; transform-origin: right center; animation-delay: 0.35s; }
.cline:nth-child(4)  { left: 38%; animation-delay: 0.6s; }
.cline:nth-child(5)  { left: 68%; animation-delay: 0.9s; }

/* dot marker */
.hero-dot {
  position: absolute;
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--br);
  opacity: 0;
  animation: dotAppear 0.3s ease forwards;
}
@keyframes dotAppear { to { opacity: 1; } }
.hero-dot:nth-child(6)  { top: 28%; left: 45%; animation-delay: 2.5s; }
.hero-dot:nth-child(7)  { top: 62%; left: 20%; animation-delay: 2.7s; }
.hero-dot:nth-child(8)  { top: 44%; left: 40%; animation-delay: 2.6s; }

/* hero content */
.hero-content {
  position: relative; z-index: 2;
  max-width: 1100px;
}

.hero-eyebrow {
  font-size: 9px;
  letter-spacing: 0.42em;
  text-transform: uppercase;
  color: var(--br);
  margin-bottom: 40px;
  opacity: 0;
  animation: fadeUp 0.8s var(--ease) 0.4s forwards;
}

.hero-h1 {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 300;
  font-size: clamp(64px, 10.5vw, 140px);
  line-height: 1.05;
  color: var(--co);
  opacity: 0;
  animation: fadeUp 1s var(--ease) 0.6s forwards;
  letter-spacing: -0.01em;
}
.hero-h1 em { font-style: italic; color: var(--br); }
.hero-h1 span { display: block; }

.hero-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 52px;
  opacity: 0;
  animation: fadeUp 0.8s var(--ease) 1s forwards;
}

.hero-tagline {
  font-family: 'Cormorant Garamond', serif;
  font-size: 17px;
  font-style: italic;
  font-weight: 300;
  color: rgba(229,227,222,0.45);
  max-width: 340px;
  line-height: 1.55;
}

.hero-scroll {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  color: var(--sg);
  font-size: 8.5px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
}
.hero-scroll-line {
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, var(--br), transparent);
  animation: scrollPulse 2s ease-in-out infinite;
}
@keyframes scrollPulse {
  0%, 100% { opacity: 0.4; transform: scaleY(1); }
  50%       { opacity: 1;   transform: scaleY(1.15); }
}

.hero-loc {
  font-size: 9px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: rgba(229,227,222,0.25);
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ─── SECTION SHARED ───────────────────────── */
section { position: relative; }

.reveal {
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 0.8s var(--ease), transform 0.8s var(--ease);
}
.reveal.active {
  opacity: 1;
  transform: translateY(0);
}
.reveal.visible { opacity: 1; transform: translateY(0); }

.sec-label {
  font-size: 8.5px;
  letter-spacing: 0.38em;
  text-transform: uppercase;
  color: var(--br);
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 14px;
}
.sec-label::after {
  content: '';
  display: block;
  height: 1px;
  width: 40px;
  background: var(--br);
  opacity: 0.5;
}

/* ─── MARQUEE ───────────────────────────────── */
.marquee-wrap {
  overflow: hidden;
  background: var(--br);
  padding: 14px 0;
}
.marquee-track {
  display: flex;
  gap: 0;
  animation: marquee 22s linear infinite;
  white-space: nowrap;
}
.marquee-track span {
  font-size: 10px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.75);
  padding: 0 36px;
}
.marquee-track span em { color: white; font-style: normal; }
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

/* ─── ABOUT ─────────────────────────────────── */
#about {
  padding: 100px 72px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 100px;
  align-items: start;
  background: var(--wh);
}

.about-left {}

.about-h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(34px, 4vw, 56px);
  font-weight: 300;
  line-height: 1.15;
  margin-bottom: 32px;
  letter-spacing: -0.01em;
}
.about-h2 em { font-style: italic; color: var(--br); }

.about-body {
  font-size: 14px;
  color: var(--sg);
  line-height: 1.9;
  margin-bottom: 18px;
}

.about-sig {
  margin-top: 40px;
  padding-top: 28px;
  border-top: 1px solid rgba(31,31,31,0.08);
  display: flex;
  align-items: center;
  gap: 16px;
}
.sig-mark {
  font-family: 'Cormorant Garamond', serif;
  font-size: 28px;
  font-style: italic;
  color: var(--br);
  line-height: 1;
}
.sig-info {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.sig-name {
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.06em;
}
.sig-title {
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--sg);
}

.about-right {
  position: relative;
}

.about-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: rgba(31,31,31,0.08);
  border: 1px solid rgba(31,31,31,0.08);
}

.stat {
  background: var(--wh);
  padding: 32px 24px;
}
.stat-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 48px;
  font-weight: 300;
  line-height: 1;
  color: var(--ch);
  margin-bottom: 6px;
}
.stat-num span { color: var(--br); }
.stat-label {
  font-size: 9.5px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--sg);
}

.about-quote {
  margin-top: 20px;
  background: var(--ch);
  padding: 28px 28px;
  position: relative;
  overflow: hidden;
}
.about-quote::before {
  content: '"';
  font-family: 'Cormorant Garamond', serif;
  font-size: 100px;
  color: var(--br);
  opacity: 0.2;
  position: absolute;
  top: -16px; left: 16px;
  line-height: 1;
}
.about-quote p {
  font-family: 'Cormorant Garamond', serif;
  font-size: 19px;
  font-style: italic;
  font-weight: 300;
  color: var(--co);
  line-height: 1.55;
  position: relative;
  z-index: 1;
}

/* ─── SERVICES ──────────────────────────────── */
#services {
  padding: 120px 52px;
  background: var(--ch);
}

.services-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 64px;
}

.services-h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(36px, 4.5vw, 58px);
  font-weight: 300;
  color: var(--co);
  letter-spacing: -0.01em;
  max-width: 400px;
  line-height: 1.1;
}
.services-h2 em { font-style: italic; color: var(--br); }

.services-desc {
  max-width: 320px;
  font-size: 13.5px;
  color: var(--sg);
  line-height: 1.75;
  text-align: right;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: rgba(229,227,222,0.08);
}

.svc-card {
  background: var(--ch);
  padding: 40px 28px;
  border-top: 1px solid rgba(229,227,222,0.08);
  transition: background 0.3s;
  position: relative;
  overflow: hidden;
}
.svc-card::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 2px;
  background: var(--br);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.4s var(--ease);
}
.svc-card:hover { background: #252525; }
.svc-card:hover::after { transform: scaleX(1); }

.svc-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 11px;
  font-style: italic;
  color: var(--br);
  margin-bottom: 28px;
  opacity: 0.7;
}
.svc-icon {
  font-size: 24px;
  margin-bottom: 20px;
}
.svc-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: 20px;
  font-weight: 400;
  color: var(--co);
  margin-bottom: 14px;
  line-height: 1.2;
}
.svc-body {
  font-size: 12px;
  color: var(--sg);
  line-height: 1.7;
}


/* ─── PORTFOLIO ─── */
#portfolio { padding: 120px 0 80px; background: var(--wh); }
.pf-header { text-align: center; padding: 0 var(--pad); margin-bottom: 56px; }
.pf-tag { font-family: 'Jost',sans-serif; font-size:10px; letter-spacing:4px; text-transform:uppercase; color:var(--br); margin-bottom:16px; }
.pf-title { font-family:'Cormorant Garamond',serif; font-size:clamp(2.8rem,6vw,5rem); font-weight:400; color:var(--ch); margin-bottom:20px; line-height:1; }
.pf-meta { font-family:'Jost',sans-serif; font-size:13px; color:var(--sg); display:flex; align-items:center; justify-content:center; gap:12px; flex-wrap:wrap; }
.pf-dot { opacity:0.4; }
/* Lead — landscape image, natural proportions */
.pf-lead { position:relative; width:100%; overflow:hidden; margin-bottom:4px; }
.pf-lead img { width:100%; height:auto; display:block; }
.pf-lead-caption { position:absolute; bottom:24px; right:32px; font-family:'Jost',sans-serif; font-size:10px; letter-spacing:3px; text-transform:uppercase; color:rgba(255,255,255,0.7); }
/* Description */
.pf-desc { max-width:680px; margin:64px auto; padding:0 var(--pad); text-align:center; }
.pf-desc p { font-family:'Jost',sans-serif; font-size:16px; line-height:1.85; color:var(--sg); font-weight:300; }
/* Grid */
.pf-grid { display:grid; grid-template-columns:1fr 1fr; gap:4px; margin-bottom:4px; }
.pf-grid-item { position:relative; overflow:hidden; background:var(--ch); }
.pf-grid-tall { grid-row:span 3; }
.pf-grid-item img { width:100%; height:auto; display:block; transition:transform 0.6s var(--ease); }
.pf-grid-tall img { min-height:600px; }
.pf-grid-item:hover img { transform:scale(1.03); }
.pf-grid-caption { position:absolute; bottom:16px; left:20px; font-family:'Jost',sans-serif; font-size:10px; letter-spacing:2px; text-transform:uppercase; color:rgba(255,255,255,0.6); }
/* Tags */
.pf-tags { display:flex; gap:10px; flex-wrap:wrap; justify-content:center; padding:48px var(--pad) 0; }
.pf-tags span { font-family:'Jost',sans-serif; font-size:11px; letter-spacing:1.5px; text-transform:uppercase; color:var(--sg); padding:8px 16px; border:0.5px solid rgba(138,138,138,0.3); }
@media(max-width:768px){ .pf-grid{grid-template-columns:1fr;} .pf-grid-tall{grid-row:span 1;} .pf-grid-tall img{min-height:400px;} }

/* ── PORTFOLIO LOGO SPLIT GRID ── */
.portfolio-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  grid-template-rows: auto auto;
  gap: 3px;
  background: rgba(140,106,59,0.15);
  border: 3px solid rgba(140,106,59,0.15);
}

.proj {
  position: relative;
  overflow: hidden;
  background: var(--ch);
  aspect-ratio: unset;
}
.proj-bg {
  width: 100%; height: 100%;
  min-height: 260px;
  position: relative;
  transition: transform 0.6s var(--ease);
}
.proj:hover .proj-bg { transform: scale(1.02); }

/* shared grid bg */
.proj-bg::before {
  content: '';
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(229,227,222,0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(229,227,222,0.02) 1px, transparent 1px);
  background-size: 48px 48px;
  z-index: 0;
}

/* CELL 1 — large left — "THE FIFTH" */
.proj-bg-1 {
  background: #1a1814;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  padding: 40px 44px;
}
.proj-bg-1::after {
  content: 'THE\AFIFTH';
  white-space: pre;
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  font-family: 'Jost', sans-serif;
  font-weight: 200;
  font-size: clamp(52px, 7vw, 96px);
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(229,227,222,0.07);
  line-height: 1.05;
  text-align: center;
  z-index: 0;
  pointer-events: none;
}
/* bronze accent line left */
.proj-bg-1 .logo-accent {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 3px;
  background: var(--br);
  opacity: 0.6;
}

/* CELL 2 — top right — logo mark */
.proj-bg-2 {
  background: #171512;
  min-height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.proj-bg-2 .logo-mark-wrap {
  position: relative;
  width: 80px; height: 80px;
  z-index: 1;
}
.proj-bg-2 .logo-mark-outer {
  position: absolute; inset: 0;
  border: 1px solid rgba(229,227,222,0.2);
}
.proj-bg-2 .logo-mark-inner {
  position: absolute;
  inset: 14px;
  border: 1px solid rgba(229,227,222,0.1);
}
.proj-bg-2 .logo-mark-offset {
  position: absolute;
  top: -10px; left: -10px;
  right: 10px; bottom: 10px;
  border: 1px solid rgba(140,106,59,0.35);
}

/* CELL 3 — middle right — "WALL" */
.proj-bg-3 {
  background: #1c1a16;
  min-height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.proj-bg-3::after {
  content: 'WALL';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  font-family: 'Jost', sans-serif;
  font-weight: 500;
  font-size: clamp(28px, 4vw, 52px);
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: rgba(229,227,222,0.08);
  z-index: 0;
  pointer-events: none;
  white-space: nowrap;
}
/* bronze dot */
.proj-bg-3 .logo-dot {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, 28px);
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--br);
  opacity: 0.7;
  z-index: 1;
}

/* CELL 4 — bottom middle — tagline */
.proj-bg-4 {
  background: #1a1814;
  min-height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.proj-bg-4 .tagline-text {
  font-family: 'Cormorant Garamond', sans-serif;
  font-size: clamp(10px, 1.4vw, 14px);
  font-style: italic;
  font-weight: 300;
  letter-spacing: 0.18em;
  color: rgba(229,227,222,0.18);
  text-align: center;
  line-height: 1.6;
  padding: 0 20px;
  position: relative;
  z-index: 1;
}
.proj-bg-4::before {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 60%; height: 1px;
  background: rgba(140,106,59,0.15);
  z-index: 0;
}

/* CELL 5 — bottom right — construction lines */
.proj-bg-5 {
  background: #171512;
  min-height: 200px;
  position: relative;
}
.proj-bg-5 .cl-h1 {
  position: absolute; top: 30%; left: 0; right: 0; height: 1px;
  background: rgba(140,106,59,0.2);
}
.proj-bg-5 .cl-h2 {
  position: absolute; top: 65%; left: 15%; right: 0; height: 1px;
  background: rgba(140,106,59,0.12);
}
.proj-bg-5 .cl-v1 {
  position: absolute; left: 40%; top: 0; bottom: 0; width: 1px;
  background: rgba(140,106,59,0.12);
}
.proj-bg-5 .cl-dot1 {
  position: absolute; top: 30%; left: 40%;
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--br); opacity: 0.5;
  transform: translate(-50%, -50%);
}
.proj-bg-5 .cl-dot2 {
  position: absolute; top: 65%; left: 15%;
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--br); opacity: 0.35;
  transform: translate(-50%, -50%);
}
/* islamabad label */
.proj-bg-5::after {
  content: 'ISLAMABAD';
  position: absolute;
  bottom: 20px; right: 16px;
  font-family: 'Jost', sans-serif;
  font-size: 8px; letter-spacing: 0.3em;
  text-transform: uppercase;
  color: rgba(140,106,59,0.3);
  z-index: 1;
}

.proj-1 { grid-row: 1 / 3; }
.proj-1 .proj-bg { min-height: 100%; height: 100%; }

/* BRONZE BAND — top of grid, full width logo name */
.portfolio-logo-band {
  grid-column: 1 / -1;
  background: var(--ch);
  border-bottom: 3px solid rgba(140,106,59,0.15);
  padding: 22px 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.plb-name {
  font-family: 'Jost', sans-serif;
  font-weight: 200;
  font-size: clamp(11px, 1.5vw, 14px);
  letter-spacing: 0.42em;
  text-transform: uppercase;
  color: rgba(229,227,222,0.25);
}
.plb-name strong { font-weight: 500; color: rgba(229,227,222,0.5); }
.plb-rule { flex: 1; height: 1px; background: rgba(140,106,59,0.15); margin: 0 32px; }
.plb-label {
  font-size: 9px; letter-spacing: 0.28em;
  text-transform: uppercase; color: rgba(140,106,59,0.5);
}


.proj-info {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 24px;
  background: linear-gradient(to top, rgba(20,18,16,0.92) 0%, transparent 100%);
  transform: translateY(8px);
  transition: transform 0.35s var(--ease);
}
.proj:hover .proj-info { transform: translateY(0); }

.proj-cat {
  font-size: 8.5px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--br);
  margin-bottom: 6px;
}
.proj-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: 20px;
  font-weight: 400;
  color: var(--co);
  line-height: 1.2;
}
.proj-loc {
  font-size: 11px;
  color: var(--sg);
  margin-top: 4px;
}

/* ─── PROCESS ───────────────────────────────── */
#process {
  padding: 120px 52px;
  background: var(--wh);
}

.process-top {
  max-width: 540px;
  margin-bottom: 72px;
}
.process-h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(36px, 4vw, 54px);
  font-weight: 300;
  line-height: 1.1;
  margin-bottom: 20px;
}
.process-h2 em { font-style: italic; color: var(--br); }
.process-sub {
  font-size: 14px;
  color: var(--sg);
  line-height: 1.75;
}

.process-steps {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0;
  border: 1px solid rgba(31,31,31,0.1);
}

.step {
  padding: 36px 24px;
  border-right: 1px solid rgba(31,31,31,0.1);
  position: relative;
  transition: background 0.3s;
  display: flex;
  flex-direction: column;
}
.step:last-child { border-right: none; }
.step:hover { background: var(--brx); }

.step-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 44px;
  font-weight: 300;
  color: rgba(31,31,31,0.07);
  line-height: 1;
  margin-bottom: 16px;
  font-style: italic;
}
.step-icon { font-size: 20px; margin-bottom: 14px; }
.step-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 19px;
  font-weight: 400;
  margin-bottom: 10px;
}
.step-body {
  font-size: 12.5px;
  color: var(--sg);
  line-height: 1.65;
  margin-bottom: 18px;
  flex: 1;
}
.step-time {
  font-size: 9px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--br);
  border-top: 1px solid rgba(140,106,59,0.2);
  padding-top: 12px;
  margin-top: auto;
}



/* ─── CONTACT ───────────────────────────────── */
#contact {
  padding: 120px 52px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: start;
  background: var(--wh);
}

.contact-left {}
.contact-h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(38px, 5vw, 62px);
  font-weight: 300;
  line-height: 1.05;
  margin-bottom: 28px;
}
.contact-h2 em { font-style: italic; color: var(--br); }
.contact-sub {
  font-size: 14px;
  color: var(--sg);
  line-height: 1.8;
  margin-bottom: 52px;
}

.contact-details {
  display: flex;
  flex-direction: column;
  gap: 28px;
}
.cd-item {}
.cd-label {
  font-size: 8.5px;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--br);
  margin-bottom: 6px;
}
.cd-val {
  font-size: 15px;
  color: var(--ch);
  font-weight: 300;
}

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.field label {
  font-size: 9px;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--sg);
}
.field input,
.field select,
.field textarea {
  background: transparent;
  border: none;
  border-bottom: 1px solid rgba(31,31,31,0.2);
  padding: 10px 0;
  font-family: 'Jost', sans-serif;
  font-size: 14px;
  font-weight: 300;
  color: var(--ch);
  outline: none;
  transition: border-color 0.25s;
  width: 100%;
  cursor: none;
}
.field input:focus,
.field select:focus,
.field textarea:focus {
  border-color: var(--br);
}
.field textarea { resize: none; height: 96px; }

.form-btn {
  margin-top: 12px;
  background: var(--ch);
  color: var(--co);
  border: none;
  padding: 16px 40px;
  font-family: 'Jost', sans-serif;
  font-size: 10px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  font-weight: 400;
  align-self: flex-start;
  transition: background 0.3s;
  position: relative;
  overflow: hidden;
}
.form-btn::after {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--br);
  transform: translateX(-100%);
  transition: transform 0.4s var(--ease);
}
.form-btn:hover::after { transform: translateX(0); }
.form-btn span { position: relative; z-index: 1; }

/* ─── MOBILE MENU OVERLAY ───────────────────── */
#mobile-menu {
  position: fixed;
  inset: 0;
  z-index: 99;
  pointer-events: none;
}
#mobile-menu-panel {
  position: absolute;
  top: 0; right: 0;
  width: min(360px, 100vw);
  height: 100vh;
  background: var(--ch);
  transform: translateX(100%);
  transition: transform 0.5s var(--ease);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}
#mobile-menu.open { pointer-events: all; }
#mobile-menu.open #mobile-menu-panel { transform: translateX(0); }

#mobile-menu-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.55);
  opacity: 0;
  transition: opacity 0.4s ease;
}
#mobile-menu.open #mobile-menu-backdrop { opacity: 1; }

.mm-top {
  padding: 28px 36px;
  border-bottom: 1px solid rgba(229,227,222,0.08);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.mm-brand {
  font-family: 'Jost', sans-serif;
  font-weight: 200;
  font-size: 11px;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--co);
}
.mm-brand strong { font-weight: 500; }

.mm-close {
  width: 32px; height: 32px;
  background: none;
  border: 1px solid rgba(229,227,222,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  cursor: none;
  transition: border-color 0.2s;
}
.mm-close:hover { border-color: var(--br); }
.mm-close::before, .mm-close::after {
  content: '';
  position: absolute;
  width: 14px; height: 1px;
  background: var(--co);
}
.mm-close::before { transform: rotate(45deg); }
.mm-close::after  { transform: rotate(-45deg); }

.mm-nav {
  padding: 36px 36px;
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow-y: auto;
}
.mm-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 0;
  border-bottom: 1px solid rgba(229,227,222,0.07);
  text-decoration: none;
  color: var(--co);
  font-family: 'Cormorant Garamond', serif;
  font-size: 28px;
  font-weight: 300;
  letter-spacing: 0.02em;
  opacity: 0;
  transform: translateX(30px);
  transition: transform 0.45s var(--ease), opacity 0.45s var(--ease), color 0.2s;
}
#mobile-menu.open .mm-link { transform: translateX(0); opacity: 1; }
#mobile-menu.open .mm-link:nth-child(1) { transition-delay: 0.10s; }
#mobile-menu.open .mm-link:nth-child(2) { transition-delay: 0.15s; }
#mobile-menu.open .mm-link:nth-child(3) { transition-delay: 0.20s; }
#mobile-menu.open .mm-link:nth-child(4) { transition-delay: 0.25s; }
#mobile-menu.open .mm-link:nth-child(5) { transition-delay: 0.30s; }
#mobile-menu.open .mm-link:nth-child(6) { transition-delay: 0.35s; }
#mobile-menu.open .mm-link:nth-child(7) { transition-delay: 0.40s; }
.mm-link:hover { color: var(--brl); }

.mm-link-arrow {
  font-size: 16px;
  color: var(--br);
  opacity: 0;
  transform: translateX(-8px);
  transition: opacity 0.2s, transform 0.2s;
}
.mm-link:hover .mm-link-arrow { opacity: 1; transform: translateX(0); }

.mm-bottom {
  padding: 28px 36px;
  border-top: 1px solid rgba(229,227,222,0.08);
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.mm-cta {
  display: block;
  text-align: center;
  padding: 14px 28px;
  background: var(--br);
  color: white;
  text-decoration: none;
  font-size: 10px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  font-family: 'Jost', sans-serif;
  font-weight: 400;
  opacity: 0;
  transform: translateY(16px);
  transition: transform 0.45s var(--ease) 0.44s, opacity 0.45s var(--ease) 0.44s, background 0.2s;
}
#mobile-menu.open .mm-cta { transform: translateY(0); opacity: 1; }
.mm-cta:hover { background: var(--brl); }

.mm-socials {
  display: flex;
  gap: 20px;
  opacity: 0;
  transform: translateY(12px);
  transition: transform 0.45s var(--ease) 0.52s, opacity 0.45s var(--ease) 0.52s;
}
#mobile-menu.open .mm-socials { transform: translateY(0); opacity: 1; }
.mm-social {
  font-size: 9.5px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--sg);
  text-decoration: none;
  transition: color 0.2s;
}
.mm-social:hover { color: var(--br); }

/* also wire burger animation */
.nav-burger span {
  transition: transform 0.35s var(--ease), opacity 0.25s;
}
.nav-burger.open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
.nav-burger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
.nav-burger.open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

/* ─── VIDEO REEL ─────────────────────────────── */
#reel {
  padding: 0;
  background: var(--ch);
  position: relative;
  overflow: hidden;
}

.reel-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 80px 52px 48px;
}

.reel-h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(34px, 4vw, 54px);
  font-weight: 300;
  color: var(--co);
  line-height: 1.1;
}
.reel-h2 em { font-style: italic; color: var(--br); }

.reel-sub {
  font-size: 13px;
  color: var(--sg);
  line-height: 1.7;
  max-width: 280px;
  text-align: right;
}

/* project tabs */
.reel-tabs {
  display: flex;
  gap: 0;
  padding: 0 52px;
  margin-bottom: 32px;
  overflow-x: auto;
  scrollbar-width: none;
}
.reel-tabs::-webkit-scrollbar { display: none; }

.reel-tab {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 16px 28px;
  background: transparent;
  border: none;
  border-bottom: 1px solid rgba(229,227,222,0.1);
  cursor: none;
  text-align: left;
  min-width: 160px;
  transition: background 0.25s;
  position: relative;
}
.reel-tab::after {
  content: '';
  position: absolute;
  bottom: -1px; left: 0; right: 0;
  height: 2px;
  background: var(--br);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.35s var(--ease);
}
.reel-tab.active::after { transform: scaleX(1); }
.reel-tab:hover { background: rgba(229,227,222,0.03); }

.reel-tab-num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 11px;
  font-style: italic;
  color: var(--br);
  opacity: 0.7;
}
.reel-tab-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: 17px;
  font-weight: 400;
  color: var(--co);
  line-height: 1.2;
}
.reel-tab-cat {
  font-size: 9px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--sg);
}

/* main video stage */
.reel-stage {
  position: relative;
  width: 100%;
  aspect-ratio: 16/8;
  background: #111;
  overflow: hidden;
}

.reel-video-slot {
  position: absolute;
  inset: 0;
  opacity: 0;
  transition: opacity 0.6s var(--ease);
  display: flex;
  align-items: center;
  justify-content: center;
}
.reel-video-slot.active { opacity: 1; z-index: 1; }

/* the actual video element */
.reel-video-slot video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* placeholder when no video — CSS art */
.vid-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vp-1 { background: linear-gradient(135deg, #1e1b17 0%, #252218 60%, #1a1a1a 100%); }
.vp-2 { background: linear-gradient(160deg, #17191e 0%, #1c2028 60%, #111418 100%); }
.vp-3 { background: linear-gradient(120deg, #1a1a18 0%, #22201a 60%, #181614 100%); }
.vp-4 { background: linear-gradient(145deg, #191716 0%, #201e1a 60%, #141212 100%); }
.vp-5 { background: linear-gradient(135deg, #161618 0%, #1e1c20 60%, #111114 100%); }

.vp-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(140,106,59,0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(140,106,59,0.06) 1px, transparent 1px);
  background-size: 64px 64px;
}

.vp-lines {
  position: absolute;
  inset: 0;
  overflow: hidden;
}
.vp-line {
  position: absolute;
  background: rgba(140,106,59,0.15);
}

/* animated scan line */
.vp-scan {
  position: absolute;
  left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(140,106,59,0.4), transparent);
  animation: scanMove 4s ease-in-out infinite;
}
@keyframes scanMove {
  0%   { top: 10%; opacity: 0; }
  10%  { opacity: 1; }
  90%  { opacity: 1; }
  100% { top: 90%; opacity: 0; }
}

.vp-label {
  position: absolute;
  top: 28px; left: 36px;
  font-size: 9px;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: rgba(229,227,222,0.25);
  font-family: 'Jost', sans-serif;
}

/* play button overlay */
.play-btn {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  cursor: none;
}

.play-circle {
  width: 80px; height: 80px;
  border: 1px solid rgba(229,227,222,0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: border-color 0.3s, transform 0.3s;
  backdrop-filter: blur(4px);
  background: rgba(31,31,31,0.3);
}
.play-circle::before {
  content: '';
  position: absolute;
  inset: -8px;
  border-radius: 50%;
  border: 1px solid rgba(140,106,59,0.2);
  animation: playPulse 2.5s ease-in-out infinite;
}
@keyframes playPulse {
  0%, 100% { transform: scale(1);   opacity: 0.6; }
  50%       { transform: scale(1.1); opacity: 1; }
}

.play-circle svg {
  width: 22px; height: 22px;
  fill: var(--co);
  margin-left: 4px;
  transition: fill 0.25s;
}

.play-btn:hover .play-circle {
  border-color: var(--br);
  transform: scale(1.08);
}
.play-btn:hover .play-circle svg { fill: var(--brl); }

.play-label {
  font-size: 9px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: rgba(229,227,222,0.5);
  font-family: 'Jost', sans-serif;
}

/* overlay info strip */
.reel-info {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 40px 52px 36px;
  background: linear-gradient(to top, rgba(15,13,11,0.92) 0%, transparent 100%);
  z-index: 3;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  pointer-events: none;
}

.reel-info-left {}
.reel-proj-cat {
  font-size: 9px;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--br);
  margin-bottom: 6px;
}
.reel-proj-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(24px, 3.5vw, 42px);
  font-weight: 300;
  color: var(--co);
  line-height: 1.1;
}
.reel-proj-loc {
  font-size: 11px;
  color: rgba(229,227,222,0.4);
  margin-top: 6px;
  letter-spacing: 0.08em;
}

.reel-info-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8px;
}
.reel-counter {
  font-family: 'Cormorant Garamond', serif;
  font-size: 13px;
  font-style: italic;
  color: rgba(229,227,222,0.3);
}
.reel-duration {
  font-size: 9px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--sg);
}

/* progress bar */
.reel-progress {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 2px;
  background: rgba(229,227,222,0.08);
  z-index: 4;
}
.reel-progress-fill {
  height: 100%;
  background: var(--br);
  width: 0%;
  transition: width 0.3s linear;
}

/* nav arrows */
.reel-arrow {
  position: absolute;
  top: 50%; transform: translateY(-50%);
  z-index: 5;
  width: 48px; height: 48px;
  background: rgba(31,31,31,0.5);
  border: 1px solid rgba(229,227,222,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: none;
  transition: background 0.25s, border-color 0.25s;
  backdrop-filter: blur(4px);
}
.reel-arrow:hover { background: rgba(140,106,59,0.6); border-color: var(--br); }
.reel-arrow svg { width: 16px; height: 16px; stroke: var(--co); fill: none; stroke-width: 1.5; }
.reel-arrow-prev { left: 24px; }
.reel-arrow-next { right: 24px; }

/* ─── JOURNAL ────────────────────────────────── */
#journal {
  padding: 120px 52px;
  background: var(--wh);
}

.journal-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 56px;
}

.journal-h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(34px, 4vw, 54px);
  font-weight: 300;
  line-height: 1.1;
}
.journal-h2 em { font-style: italic; color: var(--br); }

.journal-link {
  font-size: 10px;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--br);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 10px;
  transition: gap 0.25s;
}
.journal-link:hover { gap: 16px; }
.journal-link::after { content: '→'; }

.journal-grid {
  display: grid;
  grid-template-columns: 1.6fr 1fr 1fr;
  gap: 24px;
}

.post {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  color: inherit;
  group: true;
}

.post-thumb {
  aspect-ratio: 4/3;
  overflow: hidden;
  margin-bottom: 24px;
  position: relative;
}

.post-thumb-inner {
  width: 100%; height: 100%;
  transition: transform 0.55s var(--ease);
}
.post:hover .post-thumb-inner { transform: scale(1.04); }

/* CSS art thumbnails */
.pt-1 {
  background: linear-gradient(135deg, var(--ch) 0%, #2a2420 100%);
  position: relative;
}
.pt-1::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(140,106,59,0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(140,106,59,0.08) 1px, transparent 1px);
  background-size: 28px 28px;
}
.pt-1::after {
  content: '';
  position: absolute;
  bottom: 20%; left: 15%;
  width: 70%; height: 45%;
  border: 1px solid rgba(140,106,59,0.3);
}

.pt-2 {
  background: linear-gradient(160deg, var(--co) 0%, #d4d0c8 100%);
  position: relative;
}
.pt-2::before {
  content: '';
  position: absolute;
  top: 10%; left: 10%;
  width: 80%; height: 80%;
  background: linear-gradient(135deg, rgba(140,106,59,0.12) 0%, transparent 100%);
}
.pt-2::after {
  content: '';
  position: absolute;
  bottom: 15%; right: 15%;
  width: 40%; height: 55%;
  border-left: 2px solid var(--br);
  border-top: 2px solid var(--br);
  opacity: 0.5;
}

.pt-3 {
  background: linear-gradient(180deg, #1a1a1a 0%, #252218 100%);
  position: relative;
}
.pt-3::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 35% 55%, rgba(140,106,59,0.2) 0%, transparent 55%);
}

.post-cat {
  font-size: 8.5px;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--br);
  margin-bottom: 10px;
}

.post-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 22px;
  font-weight: 400;
  line-height: 1.25;
  margin-bottom: 12px;
  color: var(--ch);
  transition: color 0.25s;
}
.post:hover .post-title { color: var(--br); }

.post-excerpt {
  font-size: 13px;
  color: var(--sg);
  line-height: 1.7;
  flex: 1;
  margin-bottom: 20px;
}

.post-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16px;
  border-top: 1px solid rgba(31,31,31,0.08);
}

.post-date {
  font-size: 10px;
  letter-spacing: 0.15em;
  color: var(--sg);
}

.post-read {
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--br);
  display: flex;
  align-items: center;
  gap: 6px;
  transition: gap 0.2s;
}
.post:hover .post-read { gap: 10px; }
.post-read::after { content: '→'; }

/* ─── FOOTER ────────────────────────────────── */
footer {
  background: var(--ch);
  padding: 52px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 40px;
}
.ft-brand {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.ft-name { display: none; }
.ft-tagline {
  font-family: 'Cormorant Garamond', serif;
  font-size: 12px;
  font-style: italic;
  color: var(--sg);
}
.ft-links {
  display: flex;
  gap: 28px;
  list-style: none;
}
.ft-links a {
  font-size: 9.5px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.3);
  text-decoration: none;
  transition: color 0.2s;
}
.ft-links a:hover { color: var(--brl); }
.ft-right {
  text-align: right;
  font-size: 10px;
  letter-spacing: 0.15em;
  color: rgba(255,255,255,0.2);
  line-height: 2;
}
.ft-right a {
  color: var(--br);
  text-decoration: none;
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  display: block;
  margin-top: 8px;
  transition: color 0.2s;
}
.ft-right a:hover { color: var(--brl); }

/* ─── MOBILE ─────────────────────────────────── */
@media (max-width: 900px) {
  nav { padding: 22px 20px; }
  nav.scrolled { padding: 14px 20px; }
  .nav-links { gap: 18px; }
  .nav-links a { font-size: 9px; }
  .nav-cta { padding: 8px 14px; font-size: 9px; }
  .nav-burger { display: none; }

  #hero { padding: 0 28px 56px; }
  .hero-bottom { flex-direction: column; align-items: flex-start; gap: 24px; }

  #reel .reel-top { padding: 60px 28px 36px; flex-direction: column; align-items: flex-start; gap: 16px; }
  #reel .reel-sub { text-align: left; }
  .reel-tabs { padding: 0 28px; }
  .reel-tab { min-width: 130px; padding: 12px 18px; }
  .reel-stage { aspect-ratio: 4/3; }
  .reel-info { padding: 24px 28px 28px; flex-direction: column; align-items: flex-start; gap: 12px; }
  .reel-arrow { display: none; }
  #journal { padding: 80px 28px; }
  .journal-top { flex-direction: column; align-items: flex-start; gap: 16px; }
  .journal-grid { grid-template-columns: 1fr; gap: 48px; }
  #about { grid-template-columns: 1fr; padding: 72px 28px; gap: 48px; }
  .about-stats { grid-template-columns: 1fr 1fr; }

  #services { padding: 80px 28px; }
  .services-top { flex-direction: column; align-items: flex-start; gap: 20px; }
  .services-desc { text-align: left; }
  .services-grid { grid-template-columns: 1fr 1fr; }

  #portfolio { padding: 80px 28px; }
  .portfolio-grid { grid-template-columns: 1fr 1fr; }
  .proj-1 { grid-column: 1 / 3; grid-row: auto; }

  #process { padding: 80px 28px; }
  .process-steps { grid-template-columns: 1fr 1fr; }
  .step { border-bottom: 1px solid rgba(31,31,31,0.1); }

  #contact { grid-template-columns: 1fr; padding: 80px 28px; gap: 52px; }
  .form-row { grid-template-columns: 1fr; }

  footer { grid-template-columns: 1fr; gap: 28px; padding: 44px 28px; }
  .ft-right { text-align: left; }
  .ft-links { flex-wrap: wrap; gap: 16px; }
}
@media (max-width: 560px) {
  .services-grid { grid-template-columns: 1fr; }
  .process-steps { grid-template-columns: 1fr; }
  .portfolio-grid { grid-template-columns: 1fr; }
  .proj-1 { grid-column: auto; }
  body { cursor: auto; }
  #cursor { display: none; }
  a, button { cursor: pointer; }
}


@media (max-width: 768px) {
  .ss-headline { top: 32px; left: 24px; right: 24px; }
  .ss-info { bottom: 44px; left: 24px; }
  .ss-desc { font-size: 13px; max-width: 280px; }
}



.pf-divider {
  height: 1px;
  background: rgba(138,138,138,0.15);
  margin: 80px var(--pad);
}
.pf-project {
  padding: 80px 0;
  background: var(--wh);
}

/* ─── PORTFOLIO INDEX ─── */
.pf-index { padding: 0 var(--pad) 80px; max-width: 1300px; margin: 0 auto; }
.pf-index-label { font-family:"Jost",sans-serif; font-size:10px; letter-spacing:4px; text-transform:uppercase; color:var(--sg); margin-bottom:32px; }
.pf-index-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:2px; }
.pf-index-card { text-decoration:none; color:inherit; display:block; }
.pf-index-thumb { position:relative; overflow:hidden; background:var(--ch); margin-bottom:16px; }
.pf-index-thumb img { width:100%; height:220px; object-fit:cover; display:block; transition:transform 0.7s cubic-bezier(.25,.46,.45,.94); }
.pf-index-card:hover .pf-index-thumb img { transform:scale(1.05); }
.pf-index-num { position:absolute; top:14px; left:16px; font-family:"Jost",sans-serif; font-size:10px; letter-spacing:2px; color:rgba(255,255,255,0.55); }
.pf-index-name { font-family:"Cormorant Garamond",serif; font-size:1.45rem; font-weight:400; color:var(--ch); margin-bottom:5px; padding:0 2px; transition:color 0.2s; }
.pf-index-card:hover .pf-index-name { color:var(--br); }
.pf-index-sub { font-family:"Jost",sans-serif; font-size:11px; color:var(--sg); letter-spacing:0.3px; padding:0 2px; margin-bottom:20px; }
@media(max-width:768px){ .pf-index-grid{ grid-template-columns:1fr; gap:0; } }
@media(max-width:900px) and (min-width:769px){ .pf-index-grid{ grid-template-columns:1fr 1fr; } }
</style>
</head>
