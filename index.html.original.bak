<!-- PROCESS -->
<section id="process">
  <div class="process-top reveal">
    <div class="sec-label">How It Works</div>
    <h2 class="process-h2">From first message<br>to <em>final handover.</em></h2>
    <p class="process-sub">Every project moves through five clear stages. You always know what's happening and what comes next.</p>
  </div>
  <div class="process-steps reveal">
    <div class="step">
      <div class="step-num">01</div>
      <div class="step-icon">🎙️</div>
      <div class="step-title">Discovery</div>
      <div class="step-body">A free 30-minute conversation on WhatsApp or in person to understand your space, your budget, and your vision. No obligation.</div>
      <div class="step-time">1 – 2 days</div>
    </div>
    <div class="step">
      <div class="step-num">02</div>
      <div class="step-icon">✏️</div>
      <div class="step-title">Concept</div>
      <div class="step-body">Mood boards, spatial diagrams, and early sketches that define the direction before a single decision is locked in.</div>
      <div class="step-time">1 – 2 weeks</div>
    </div>
    <div class="step">
      <div class="step-num">03</div>
      <div class="step-icon">📋</div>
      <div class="step-title">Design Development</div>
      <div class="step-body">Full drawings, material schedules, 3D renders, and supplier coordination. Every detail resolved before construction begins.</div>
      <div class="step-time">2 – 4 weeks</div>
    </div>
    <div class="step">
      <div class="step-num">04</div>
      <div class="step-icon">🔨</div>
      <div class="step-title">Construction</div>
      <div class="step-body">On-site execution with regular visits and quality checks. We coordinate contractors so nothing is lost between drawing and build.</div>
      <div class="step-time">4 – 12 weeks</div>
    </div>
    <div class="step">
      <div class="step-num">05</div>
      <div class="step-icon">🏠</div>
      <div class="step-title">Handover</div>
      <div class="step-body">Final walkthrough, snag list resolved, and the keys handed over. We stay reachable for any questions after you move in.</div>
      <div class="step-time">1 week</div>
    </div>
  </div>
</section>

